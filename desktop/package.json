{
  "name": "kartograaf",
  "productName": "Kartograpper",
  "version": "1.2.0",
  "description": "Teken fantasykaarten in inkt, perkament of kleur.",
  "author": "Robin Bollens",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "prepare-web": "node copy-web.js",
    "start": "npm run prepare-web && electron .",
    "dist": "npm run prepare-web && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.robinbollens.kartograaf",
    "productName": "Kartograpper",
    "files": ["main.js", "web/**/*"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kartograpper",
      "artifactName": "Kartograpper-Setup-${version}.exe"
    }
  }
}
